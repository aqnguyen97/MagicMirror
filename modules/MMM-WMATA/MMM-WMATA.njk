{% macro arrival(row) %}
    <span class="wmata-row__next wmata-row__next--{{ row.status }}">
        {% if row.next == 0 %}
            <span class="wmata-row__now">Now</span>
        {% else %}
            {{ row.next }}<span class="wmata-row__unit">min</span>
        {% endif %}
    </span>
    <span class="wmata-row__later">{{ row.later | join(", ") if row.later.length else "" }}</span>
{% endmacro %}

{% if loading %}
    <div class="dimmed light small">Loading transit times…</div>
{% else %}
<div class="wmata">

    {% if notices.length > 0 %}
        <div class="wmata-notice">
            <i class="fas fa-triangle-exclamation"></i>
            {{ notices | join(" · ") }}
        </div>
    {% endif %}

    <div class="wmata-columns">

        {% if showTrains %}
        <div class="wmata-column">
            <div class="wmata-column__header">
                <i class="fas fa-train-subway"></i>
                {{ trainStationName or "Metro" }}
                {% if trainWalkMinutes > 0 %}<span class="wmata-column__walk">· {{ trainWalkMinutes }} min walk</span>{% endif %}
            </div>

            {% for row in trainRows %}
                <div class="wmata-row{% if row.newGroup %} wmata-row--new-group{% endif %}">
                    <span class="wmata-line wmata-line--{{ row.line }}">{{ row.line }}</span>
                    <span class="wmata-row__name">{{ row.destination }}</span>
                    {{ arrival(row) }}
                </div>
            {% else %}
                <div class="wmata-empty">No trains scheduled</div>
            {% endfor %}
        </div>
        {% endif %}

        {% if showBuses %}
        <div class="wmata-column">
            <div class="wmata-column__header">
                <i class="fas fa-bus"></i>
                {{ busLabel }}
                {% if busWalkMinutes > 0 %}<span class="wmata-column__walk">· {{ busWalkMinutes }} min walk</span>{% endif %}
            </div>

            {% for row in busRows %}
                <div class="wmata-row">
                    <span class="wmata-route">{{ row.route }}</span>
                    <span class="wmata-row__name">{{ row.direction }}</span>
                    {{ arrival(row) }}
                </div>
            {% else %}
                <div class="wmata-empty">{{ "No buses scheduled" if busesLoaded else "Loading buses…" }}</div>
            {% endfor %}
        </div>
        {% endif %}

    </div>

    {% if updated %}
        <div class="wmata-updated">Updated {{ updated }}</div>
    {% endif %}
</div>
{% endif %}

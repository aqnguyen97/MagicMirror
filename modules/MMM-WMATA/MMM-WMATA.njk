{# Status for one feed (trains or buses), shown in two places:
   - statusText: warning next to the card title after 30 min (or if it never loaded)
   - statusBar:  the card's bottom edge (styles in css/custom.css) #}
{% macro statusText(s) %}
    {% if s.state == "error" %}
        <span class="status-error"><i class="fas fa-triangle-exclamation"></i> {{ "Last updated " + s.label if s.label else "Can't load data" }}</span>
    {% endif %}
{% endmacro %}

{% macro statusBar(s) %}
    {% if s.state %}
        {% set barState = "stale" if s.state == "error" else s.state %}
        <div class="status-bar status-bar--{{ barState }}{% if s.flash and s.state == 'fresh' %} status-bar--flash{% endif %}"
             {% if s.state == "fresh" %}style="--bar-duration: {{ s.duration }}s; --bar-age: {{ s.age }}s"{% endif %}></div>
    {% endif %}
{% endmacro %}

{% macro arrival(row) %}
    <span class="wmata-row__next wmata-row__next--{{ row.status }}">
        {% if not row.hasNext %}
            <span class="wmata-row__none">—</span>
        {% elif row.next == 0 %}
            <span class="wmata-row__now">Now</span>
        {% else %}
            {{ row.next }}<span class="wmata-row__unit">min</span>
        {% endif %}
    </span>
    <span class="wmata-row__later">{{ row.later | join(", ") if row.later.length else "" }}</span>
{% endmacro %}

{% if loadFailed %}
    <div class="wmata wmata--message"><span class="status-error"><i class="fas fa-triangle-exclamation"></i> Can't load transit data</span></div>
{% elif loading %}
    <div class="wmata wmata--message">Loading transit times…</div>
{% else %}
<div class="wmata">

    {% if notices.length > 0 %}
        <div class="wmata-notice">
            <i class="fas fa-triangle-exclamation"></i>
            {{ notices | join(" · ") }}
        </div>
    {% endif %}

    <div class="wmata-columns">

        {% if showTrains %}
        <div class="wmata-column">
            <div class="wmata-column__header">
                <span class="wmata-column__title">
                    <i class="fas fa-train-subway"></i>
                    {{ trainStationName or "Metro" }}
                    {% if showWalkTimes and trainWalkMinutes > 0 %}<span class="wmata-column__walk">· {{ trainWalkMinutes }} min walk</span>{% endif %}
                </span>
                {{ statusText(trainStatus) }}
            </div>

            {% for row in trainRows %}
                <div class="wmata-row{% if row.newGroup %} wmata-row--new-group{% endif %}">
                    <span class="wmata-line wmata-line--{{ row.line }}">{{ row.line }}</span>
                    <span class="wmata-row__name">{{ row.destination }}</span>
                    {{ arrival(row) }}
                </div>
            {% else %}
                <div class="wmata-empty">No trains scheduled</div>
            {% endfor %}

            {{ statusBar(trainStatus) }}
        </div>
        {% endif %}

        {% if showBuses %}
        <div class="wmata-column">
            <div class="wmata-column__header">
                <span class="wmata-column__title">
                    <i class="fas fa-bus"></i>
                    {{ busLabel }}
                    {% if showWalkTimes and busWalkMinutes > 0 %}<span class="wmata-column__walk">· {{ busWalkMinutes }} min walk</span>{% endif %}
                </span>
                {{ statusText(busStatus) }}
            </div>

            {% for row in busRows %}
                <div class="wmata-row">
                    <span class="wmata-route">{{ row.route }}</span>
                    <span class="wmata-row__name">
                        {{ row.direction }}
                        {% if row.detail %}<span class="wmata-row__detail">{{ row.detail }}</span>{% endif %}
                    </span>
                    {{ arrival(row) }}
                </div>
            {% else %}
                <div class="wmata-empty">{{ "No buses scheduled" if busesLoaded else "Loading buses…" }}</div>
            {% endfor %}

            {{ statusBar(busStatus) }}
        </div>
        {% endif %}

    </div>
</div>
{% endif %}
